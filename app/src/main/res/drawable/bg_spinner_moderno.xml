<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <solid android:color="#18000000" />

            <corners android:radius="14dp" />

        </shape>

    </item>


    <!-- Contenedor principal -->
    <item
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <solid android:color="#F8FAFC" />

            <stroke
                android:width="1dp"
                android:color="#3B5BDB" />

            <corners android:radius="14dp" />

            <padding
                android:left="12dp"
                android:top="2dp"
                android:right="12dp"
                android:bottom="2dp" />

        </shape>

    </item>

</layer-list>