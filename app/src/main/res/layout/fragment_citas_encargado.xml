<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerCitas"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título + notificaciones -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GerIApp"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas médicas"
                    android:textColor="#DDE5FF"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- CAMPANA -->
            <!-- ================================================== -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificacionesCitas"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificacionesCitas"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>


        <!-- ================================================== -->
        <!-- BUSCADOR -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/searchContainerCitas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/bg_search">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/search"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/edtBuscarPaciente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Buscar paciente..."
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- CONTENIDO DESPLAZABLE -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenidoCitas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/headerCitas"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationCitas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">


            <!-- ================================================== -->
            <!-- SELECTOR PACIENTES / CITAS -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/selectorCitas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_search"
                android:padding="4dp">


                <!-- PACIENTES -->

                <LinearLayout
                    android:id="@+id/tabPacientesCitas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_tab_seleccionada"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconTabPacientesCitas"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:src="@drawable/person"
                        app:tint="#FFFFFF"
                        android:contentDescription="Pacientes" />

                    <TextView
                        android:id="@+id/textTabPacientesCitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Pacientes"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- CITAS -->

                <LinearLayout
                    android:id="@+id/tabCitasCitas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconTabCitasCitas"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:src="@drawable/calendario"
                        app:tint="#98A2B3"
                        android:contentDescription="Citas" />

                    <TextView
                        android:id="@+id/textTabCitasCitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Citas"
                        android:textColor="#98A2B3"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================== -->
            <!-- SECCIÓN PACIENTES -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/contenedorPacientesCitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/txtTituloPacientesCita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.08"
                    android:text="PACIENTES"
                    android:textColor="#687078"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPacientesCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="10dp"
                    tools:listitem="@layout/item_paciente_cita" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- SECCIÓN CITAS -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/contenedorCitasProgramadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <TextView
                    android:id="@+id/txtTituloCitasProgramadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.08"
                    android:text="CITAS PROGRAMADAS"
                    android:textColor="#687078"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCitasEncargado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="10dp"
                    tools:listitem="@layout/item_cita_encargado" />


                <!-- MENSAJE CUANDO NO HAY CITAS -->

                <TextView
                    android:id="@+id/txtSinCitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:text="No hay citas programadas"
                    android:textColor="#98A2B3"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ====================================================== -->
    <!-- MENÚ INFERIOR -->
    <!-- ====================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCitas"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="55dp"
        app:cardBackgroundColor="#E9ECEF"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">


            <!-- ================================================== -->
            <!-- 1. INICIO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navInicioCitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconInicioCitas"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textInicioCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 2. ASIGNAR TURNO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navAsignarTurnoCitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconAsignarTurnoCitas"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendar_dia"
                    android:contentDescription="Asignar turno"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textAsignarTurnoCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 3. CITAS - SELECCIONADO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navCitasCitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconCitasCitas"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textCitasCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 4. MI PERFIL -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navPerfilCitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconPerfilCitas"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/person"
                    android:contentDescription="Mi perfil"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textPerfilCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>