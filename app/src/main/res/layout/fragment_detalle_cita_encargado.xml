<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerDetalleCita"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- VOLVER -->

        <ImageView
            android:id="@+id/btnVolverDetalleCita"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:padding="10dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="Volver"
            app:tint="@color/white" />


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloDetalleCita"
            android:layout_width="0dp"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Detalle de cita"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- CONTENIDO -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetalleCita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="30dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerDetalleCita"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================== -->
            <!-- ENCABEZADO DE SECCIÓN -->
            <!-- ================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CITA MÉDICA"
                    android:textColor="#687078"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtSubtituloDetalleCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="#98A2B3"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- PACIENTE -->
            <!-- ================================================== -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPacienteDetalleCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">


                    <ImageView
                        android:id="@+id/imgPacienteDetalleCita"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:padding="9dp"
                        android:src="@drawable/img"
                        android:contentDescription="Paciente" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPacienteDetalleCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#1F2937"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHabitacionDetalleCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textColor="#667085"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- INFORMACIÓN DE LA CITA -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="INFORMACIÓN DE LA CITA"
                android:textColor="#687078"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cardInformacionCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- TIPO -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de cita"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtTipoDetalleCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <!-- ESPECIALIDAD -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Especialidad"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtEspecialidadDetalleCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <!-- FECHA Y HORA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- FECHA -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha"
                                android:textColor="#98A2B3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtFechaDetalleCita"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text=""
                                android:textColor="#1F2937"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- HORA -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hora"
                                android:textColor="#98A2B3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtHoraDetalleCita"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text=""
                                android:textColor="#1F2937"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- MOTIVO -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Motivo de la cita"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtMotivoDetalleCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#1F2937"
                        android:textSize="15sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- CUIDADOR ASIGNADO -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CUIDADOR ASIGNADO"
                android:textColor="#687078"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cardCuidadorDetalleCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">


                    <ImageView
                        android:id="@+id/imgCuidadorDetalleCita"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="9dp"
                        android:src="@drawable/persona_encargado"
                        android:contentDescription="Cuidador" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtCuidadorDetalleCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtTelefonoCuidadorDetalleCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text=""
                            android:textColor="#667085"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- ESTADO DE LA CITA -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ESTADO DE LA CITA"
                android:textColor="#687078"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cardEstadoDetalleCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado actual"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/txtEstadoDetalleCita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text=""
                        android:textColor="@color/text_status"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_status_activo" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- RESULTADO / ASISTENCIA -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="RESULTADO DE LA CITA"
                android:textColor="#687078"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cardResultadoCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ASISTENCIA -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asistencia"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/txtAsistenciaDetalleCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <!-- RESULTADO -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Resultado"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/txtResultadoDetalleCita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="#667085"
                        android:textSize="14sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- OBSERVACIONES E INCIDENTES -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OBSERVACIONES E INCIDENTES"
                android:textColor="#687078"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cardObservacionesDetalleCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <TextView
                    android:id="@+id/txtObservacionesDetalleCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:padding="16dp"
                    android:text=""
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- BOTÓN EDITAR -->
            <!-- ================================================== -->

            <Button
                android:id="@+id/btnEditarCita"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:text="EDITAR CITA"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#3B5BDB" />


            <!-- ================================================== -->
            <!-- BOTÓN ELIMINAR -->
            <!-- ================================================== -->

            <Button
                android:id="@+id/btnEliminarCita"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="ELIMINAR CITA"
                android:textColor="@color/text_status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/activo" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ====================================================== -->
    <!-- ESTADO DE CARGA -->
    <!-- ====================================================== -->

    <FrameLayout
        android:id="@+id/loadingDetalleCita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F8FAFC"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerDetalleCita"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">


            <ProgressBar
                android:id="@+id/progressDetalleCita"
                android:layout_width="42dp"
                android:layout_height="42dp" />


            <TextView
                android:id="@+id/txtLoadingDetalleCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Cargando información de la cita..."
                android:textColor="#667085"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>


    <!-- ====================================================== -->
    <!-- ERROR / SIN INFORMACIÓN -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/contenedorErrorDetalleCita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:background="#F8FAFC"
        app:layout_constraintTop_toBottomOf="@id/headerDetalleCita"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/calendario"
            android:contentDescription="Sin información"
            app:tint="#98A2B3" />


        <TextView
            android:id="@+id/txtErrorDetalleCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="No se pudo cargar la información de la cita."
            android:textColor="#667085"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>