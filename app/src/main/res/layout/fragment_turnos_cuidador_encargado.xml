<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ===================================================== -->
    <!-- CONTENIDO CON SCROLL -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTurnos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/bg_rounded"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="30dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <!-- BOTÓN VOLVER -->

                <ImageView
                    android:id="@+id/btnVolverTurnos"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Volver"
                    android:padding="9dp"
                    android:src="@drawable/arrow_back"
                    app:tint="@android:color/white" />

                <!-- NOMBRE DEL CUIDADOR -->

                <TextView
                    android:id="@+id/txtNombreCuidadorTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nombre del cuidador"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- CARGO -->

                <TextView
                    android:id="@+id/txtCargoCuidadorTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Cuidador"
                    android:textColor="#DDE5FF"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <!-- ================================================= -->
                <!-- TÍTULO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="TURNOS"
                    android:textColor="#687078"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Gestiona los turnos de este cuidador."
                    android:textColor="#212529"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- SELECTOR DE SECCIONES -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/selectorTurnos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_selector_citas"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- ============================================= -->
                    <!-- TURNOS ASIGNADOS -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/btnTurnosAsignados"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_selector_activo"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Turnos asignados"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- ============================================= -->
                    <!-- TURNOS PASADOS -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/btnTurnosPasados"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Turnos pasados"
                        android:textColor="#687078"
                        android:textSize="13sp"
                        android:textStyle="normal" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- INFORMACIÓN -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/cardInfoTurnos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_icono_modulo"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Información de turnos"
                        android:src="@drawable/calendar_dia"
                        app:tint="#3B5BDB" />

                    <TextView
                        android:id="@+id/txtInfoTurnos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Estos son los turnos actualmente asignados al cuidador."
                        android:textColor="#687078"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MENSAJE SIN TURNOS -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtSinTurnos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_icono_modulo"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Este cuidador no tiene turnos asignados."
                    android:textColor="#98A2B3"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- ================================================= -->
                <!-- LISTA DE TURNOS -->
                <!-- ================================================= -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTurnos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_turno_encargado" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>