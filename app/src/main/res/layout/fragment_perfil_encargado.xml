<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ========================= -->
        <!-- TÍTULO + NOTIFICACIÓN -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GerIApp"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#DDE5FF"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- ========================= -->
            <!-- CAMPANA -->
            <!-- ========================= -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificacionesPerfil"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificacionesPerfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- FOTO DEL ENCARGADO -->
        <!-- ========================= -->

        <ImageView
            android:id="@+id/imgPerfilEncargado"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:src="@drawable/person"
            android:background="@drawable/bg_estado_perfil"
            android:contentDescription="Foto del encargado" />


        <!-- ========================= -->
        <!-- NOMBRE -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtNombrePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:text="David"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ========================= -->
        <!-- CARGO -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtCargoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:text="Encargado"
            android:textColor="#DDE5FF"
            android:textSize="13sp" />


        <!-- ========================= -->
        <!-- ESTADO -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtEstadoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_estado_perfil"
            android:paddingStart="11dp"
            android:paddingTop="3dp"
            android:paddingEnd="11dp"
            android:paddingBottom="3dp"
            android:text="ACTIVO"
            android:textColor="#2E7D32"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO DEL PERFIL -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerPerfil"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- INFORMACIÓN PERSONAL -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN PERSONAL"
                android:textColor="#687078"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- ========================= -->
            <!-- TARJETA INFORMACIÓN -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/redondeado_card">

                <!-- NOMBRE COMPLETO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtNombreCompletoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="David"
                    android:textColor="#1D2939"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E9ECEF" />

                <!-- DOCUMENTO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documento"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtDocumentoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CC 1.000.000.000"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E9ECEF" />

                <!-- CORREO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="correo@ejemplo.com"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E9ECEF" />

                <!-- TELÉFONO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTelefonoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="300 000 0000"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- EDITAR INFORMACIÓN -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Editar información"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_azul"
                android:clickable="true"
                android:focusable="true" />


            <!-- ========================= -->
            <!-- CONFIGURACIÓN -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="CONFIGURACIÓN"
                android:textColor="#687078"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ========================= -->
            <!-- NOTIFICACIONES -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@drawable/redondeado_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificaciones"
                        android:textColor="#1D2939"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Recibir alertas y novedades"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotificaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- CAMBIAR CONTRASEÑA -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/cardCambiarContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@drawable/redondeado_card"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cambiar contraseña"
                        android:textColor="#1D2939"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Actualiza tu contraseña de acceso"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#98A2B3"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- CERRAR SESIÓN -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="Cerrar sesión"
                android:textColor="@color/text_status"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- MENÚ INFERIOR -->
    <!-- ========================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationPerfil"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="55dp"
        app:cardBackgroundColor="#E9ECEF"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">


            <!-- ================= -->
            <!-- 1. INICIO -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navInicioPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconInicioPerfil"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textInicioPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================= -->
            <!-- 2. ASIGNAR TURNO -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navAsignarTurnoPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconAsignarTurnoPerfil"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendar_dia"
                    android:contentDescription="Asignar turno"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textAsignarTurnoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================= -->
            <!-- 3. CITAS -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navCitasPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconCitasPerfil"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textCitasPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================= -->
            <!-- 4. MI PERFIL -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navPerfilPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconPerfilPerfil"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/person"
                    android:contentDescription="Mi perfil"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textPerfilPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>