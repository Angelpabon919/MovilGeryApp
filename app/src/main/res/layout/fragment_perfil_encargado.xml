<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="0dp"
        android:layout_height="285dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="22dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="logo geriapp"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_geriapp1"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GerIApp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#E5ECFF"
                    android:textSize="16sp" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificacionesPerfil"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificacionesPerfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text=""
                    android:visibility="gone"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/imgPerfilEncargado"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:src="@drawable/persona_encargado"
            android:background="@drawable/bg_estado_perfil"
            android:contentDescription="Foto del encargado" />

        <TextView
            android:id="@+id/txtNombrePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="9dp"
            android:text="David Luna"
            android:textColor="@android:color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCargoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Encargado"
            android:textColor="#E5ECFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtEstadoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="ACTIVO" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- CONTENIDO -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerPerfil"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- INFORMACIÓN PERSONAL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN PERSONAL"
                android:textColor="#344054"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_card_perfil">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtNombreCompletoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="David Luna"
                    android:textColor="#1D2939"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EEF1F4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documento"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtDocumentoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="CC 1.000.000.000"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EEF1F4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="correo@ejemplo.com"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EEF1F4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtTelefonoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="300 000 0000"
                    android:textColor="#1D2939"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- EDITAR INFORMACIÓN -->

            <TextView
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Editar información"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_azul"
                android:clickable="true"
                android:focusable="true" />


            <!-- CONFIGURACIÓN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CONFIGURACIÓN"
                android:textColor="#344054"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />


            <!-- NOTIFICACIONES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_card_perfil">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/notifications"
                    android:backgroundTint="@color/secondary"
                    android:background="@drawable/bg_nav_selected" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificaciones"
                        android:textColor="#1D2939"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Recibir alertas y novedades"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotificaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>


            <!-- CAMBIAR CONTRASEÑA -->

            <LinearLayout
                android:id="@+id/cardCambiarContrasena"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_card_perfil"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/password"
                    android:backgroundTint="@color/secondary"
                    android:background="@drawable/bg_nav_selected" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cambiar contraseña"
                        android:textColor="#1D2939"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Actualiza tu contraseña de acceso"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#667085"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- CERRAR SESIÓN -->

            <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="Cerrar sesión"
                android:textColor="#B42318"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- MENU INFERIOR -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationPerfil"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F7F9FC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/navInicioPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconInicioPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textInicioPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAsignarTurnoPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconAsignarTurnoPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendar_dia"
                    android:contentDescription="Asignar turno"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textAsignarTurnoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/navCitasPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconCitasPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textCitasPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPerfilPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_nav_selected">

                <ImageView
                    android:id="@+id/iconPerfilPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/persona_encargado"
                    android:contentDescription="Mi perfil"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textPerfilPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>