<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Icono de ubicación verificada -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="32dp">

        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_bienvenida_sede_circulo" />

        <TextView
            android:id="@+id/iconoVerificado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textColor="#3B5BDB"
            android:textSize="64sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Título -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="¡Bienvenido a la sede!"
        android:textColor="#3B5BDB"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Mensaje -->
    <TextView
        android:id="@+id/tvMensajeLlegada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Tu ubicación ha sido verificada correctamente."
        android:textColor="#64748B"
        android:textSize="16sp" />

    <!-- Estado -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_estado_sede"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_punto_verificado" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Sede confirmada"
            android:textColor="#3B5BDB"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Transición -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Preparando tu jornada..."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

</LinearLayout>
