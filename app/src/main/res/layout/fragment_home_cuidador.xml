<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- CONTENIDO DESPLAZABLE: inicia detrás del header fijo -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHomeCuidador"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:elevation="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationCuidador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- TARJETA MEDICAMENTOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMedicamentos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="230dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- ENCABEZADO -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <ImageView
                            android:id="@+id/imgMedIcon"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:padding="10dp"
                            android:background="@drawable/bg_bienvenida_sede_circulo"
                            android:src="@drawable/ic_medicamento"
                            app:tint="#3B5BDB"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toEndOf="@id/imgMedIcon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvMedTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Medicamentos de hoy"
                                android:textColor="#172033"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvMedSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Sigue el progreso de la administración"
                                android:textColor="#64748B"
                                android:textSize="11sp"/>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- HORARIOS HORIZONTALES -->
                    <LinearLayout
                        android:id="@+id/layoutHorariosMedicamentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- MAÑANA -->
                        <LinearLayout
                            android:id="@+id/btnHorarioManana"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_horario_manana"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="3dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☀ Mañana"
                                android:textColor="#172033"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvCantidadManana"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0 medicamentos"
                                android:textColor="#475467"
                                android:textSize="10sp"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- TARDE -->
                        <LinearLayout
                            android:id="@+id/btnHorarioTarde"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_horario_tarde"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="3dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌤 Tarde"
                                android:textColor="#172033"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvCantidadTarde"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0 medicamentos"
                                android:textColor="#475467"
                                android:textSize="10sp"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- NOCHE -->
                        <LinearLayout
                            android:id="@+id/btnHorarioNoche"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_horario_noche"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="3dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☾ Noche"
                                android:textColor="#172033"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvCantidadNoche"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0 medicamentos"
                                android:textColor="#475467"
                                android:textSize="10sp"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- PANEL ACTIVO: ENCABEZADO + LISTA -->
                    <LinearLayout
                        android:id="@+id/layoutListaMedicamentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_horario_manana"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- ENCABEZADO DEL HORARIO -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/headerHorarioMedicamentos"
                            android:layout_width="match_parent"
                            android:layout_height="40dp">

                            <TextView
                                android:id="@+id/tvTituloHorarioActivo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="☀ Medicamentos – Mañana"
                                android:textColor="#172033"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/tvRangoHorario"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <TextView
                                android:id="@+id/tvRangoHorario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_hora_medicamento"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="5dp"
                                android:text="06:00 – 11:30"
                                android:textColor="#172033"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toStartOf="@id/btnToggleMedicamentos"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <ImageView
                                android:id="@+id/btnToggleMedicamentos"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:padding="5dp"
                                android:src="@drawable/ic_arrow_down"
                                android:rotation="180"
                                android:contentDescription="Ocultar medicamentos"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#172033"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- LISTA REAL DE MEDICAMENTOS -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMedicamentosHorario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:visibility="visible"
                            tools:listitem="@layout/item_medicamento_cuidador"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TITULO PACIENTES -->
            <LinearLayout
                android:id="@+id/layoutHeaderPacientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardMedicamentos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvLabelPacientes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PACIENTES ASIGNADOS"
                    android:textColor="#475467"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"/>

                <ImageView
                    android:id="@+id/btnEditPacientes"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Editar pacientes"
                    app:tint="#3B5BDB"/>
            </LinearLayout>

            <!-- PACIENTES ASIGNADOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPacientesAsignados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/layoutHeaderPacientes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_paciente"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- HEADER FIJO SUPERPUESTO -->
    <!-- HEADER -->
    <View
        android:id="@+id/viewHeaderBackground"
        android:layout_width="0dp"
        android:layout_height="210dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LOGO -->
    <LinearLayout
        android:id="@+id/layoutMarcaGerIApp"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="27dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/logo_geriapp1"
            android:scaleType="centerInside"
            android:contentDescription="Logo GerIApp"/>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GerIApp"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- NOTIFICACIONES -->
    <ImageView
        android:id="@+id/btnNotification"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="18dp"
        android:padding="12dp"
        android:background="@drawable/bg_notifi"
        android:src="@drawable/notifications"
        android:contentDescription="Notificaciones"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CIERRE DE TURNO -->
    <FrameLayout
        android:id="@+id/contenedorExitTurno"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_boton_azul"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnNotification">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_exit_turno"
            app:tint="#FFFFFF"/>
    </FrameLayout>

    <!-- SALUDO -->
    <TextView
        android:id="@+id/tvUserWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="20dp"
        android:text="Hola, Angela"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutMarcaGerIApp" />

    <TextView
        android:id="@+id/tvDescripcionCuidador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="20dp"
        android:text="Tu jornada de cuidado comienza aquí"
        android:textColor="#E5ECFF"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserWelcome"/>

    <!-- BUSCADOR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcionCuidador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/search"
                android:contentDescription="Buscar paciente"
                app:tint="#667085"/>

            <EditText
                android:id="@+id/etSearchPaciente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar paciente..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#1F2937"
                android:textColorHint="#8A94A6"
                android:textSize="14sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- NAVEGACION INFERIOR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCuidador"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- INICIO -->
            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    app:tint="#3B5BDB"/>

                <TextView
                    android:id="@+id/textInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- AGENDA -->
            <LinearLayout
                android:id="@+id/navAgenda"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/iconAgenda"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/agenda"
                        app:tint="#7F8A9A"/>

                    <View
                        android:id="@+id/badgeAgenda"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge_novedad"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/textAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Agenda"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- CAMARAS -->
            <LinearLayout
                android:id="@+id/navCamaras"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconCamaras"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/outline_camera_video_24"
                    app:tint="#7F8A9A"/>

                <TextView
                    android:id="@+id/textCamaras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cámaras"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- PERFIL -->
            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/persona_encargado"
                    app:tint="#7F8A9A"/>

                <TextView
                    android:id="@+id/textPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Perfil"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>