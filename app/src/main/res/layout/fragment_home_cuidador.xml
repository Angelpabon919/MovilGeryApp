<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ===================================================== -->
    <!-- HEADER AZUL -->
    <!-- ===================================================== -->


    <View
        android:id="@+id/viewHeaderBackground"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="29dp"
        android:text="GeriApp"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvUserWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bienvenida, cuidadora Angela"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/tvAppName"
        app:layout_constraintTop_toBottomOf="@id/tvAppName" />

    <ImageView
        android:id="@+id/btnNotification"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="15dp"
        android:background="@drawable/bg_notifi"
        android:contentDescription="Notificaciones"
        android:src="@drawable/notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAppName" />

    <!-- ===================================================== -->
    <!-- BUSCADOR -->
    <!-- ===================================================== -->

=======


    <!-- Buscador: Buscar paciente -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserWelcome">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">


            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#64748B" />

            <EditText
                android:id="@+id/etSearchPaciente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Buscar paciente..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ===================================================== -->
    <!-- CARD MEDICAMENTOS -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMedicamentos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="75dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardSearch">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeaderMedicamentos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgMedIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMedTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="Medicamentos de hoy"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnExpandMedicamentos"
                    app:layout_constraintStart_toEndOf="@id/imgMedIcon"
                    app:layout_constraintTop_toTopOf="@id/imgMedIcon" />

                <TextView
                    android:id="@+id/tvMedSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Consolidado pacientes en turno"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="@id/tvMedTitle"
                    app:layout_constraintStart_toStartOf="@id/tvMedTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvMedTitle" />

                <ImageView
                    android:id="@+id/btnExpandMedicamentos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layoutListaMedicamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvTituloManana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌞 Mañana"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/tvMedicamentosManana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Cargando..."
                    android:textColor="#64748B"/>


                <TextView
                    android:id="@+id/tvTituloTarde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🌤 Tarde"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/tvMedicamentosTarde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Cargando..."
                    android:textColor="#64748B"/>


                <TextView
                    android:id="@+id/tvTituloNoche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🌙 Noche"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/tvMedicamentosNoche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Cargando..."
                    android:textColor="#64748B"/>


            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ===================================================== -->
    <!-- TITULO PACIENTES -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutHeaderPacientes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMedicamentos">

        <TextView
            android:id="@+id/tvLabelPacientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PACIENTES ASIGNADOS"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnEditPacientes"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#64748B" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- LISTA PACIENTES -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPacientesAsignados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="105dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeaderPacientes"
        tools:listitem="@layout/item_paciente" />

    <!-- ===================================================== -->
    <!-- NAVEGACION INFERIOR CUIDADOR -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCuidador"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F7F9FC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- ================= INICIO ================= -->

            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:src="@drawable/home"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================= AGENDA ================= -->

            <LinearLayout
                android:id="@+id/navAgenda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/iconAgenda"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Agenda"
                        android:src="@drawable/agenda" />

                    <View
                        android:id="@+id/badgeAgenda"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge_novedad"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Agenda"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ================= CAMARAS ================= -->

            <LinearLayout
                android:id="@+id/navCamaras"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconCamaras"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Cámaras"
                    android:src="@drawable/outline_camera_video_24"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textCamaras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cámaras"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- ================= PERFIL ================= -->

            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Mi perfil"
                    android:src="@drawable/persona_encargado"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Perfil"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>