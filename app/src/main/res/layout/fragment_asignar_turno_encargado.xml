<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TÍTULO + NOTIFICACIONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="logo geriapp"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_geriapp1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GerIApp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#DDE5FF"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- CAMPANA -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificacionesAsignarTurno"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificacionesAsignarTurno"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text=""
                    android:visibility="gone"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- CONTENIDO -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        android:windowSoftInputMode="adjustResize"
        app:layout_constraintTop_toBottomOf="@id/headerAsignarTurno"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationAsignarTurno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">


            <!-- ================================================== -->
            <!-- BARRA DE PROGRESO -->
            <!-- ================================================== -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardProgresoAsignarTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <!-- INDICADORES -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- ================================================== -->
                        <!-- PASO 1 -->
                        <!-- ================================================== -->

                        <LinearLayout
                            android:id="@+id/contenedorPaso1AsignarTurno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/indicadorPaso1AsignarTurno"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#3B5BDB"
                                app:cardCornerRadius="21dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/txtNumeroPaso1AsignarTurno"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="1"
                                    android:textColor="@android:color/white"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/txtPaso1AsignarTurno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Turno"
                                android:textColor="#3B5BDB"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- CONECTOR 1 -->

                        <View
                            android:id="@+id/lineaPaso1AsignarTurno"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="18dp"
                            android:background="#D9E1F2" />


                        <!-- ================================================== -->
                        <!-- PASO 2 -->
                        <!-- ================================================== -->

                        <LinearLayout
                            android:id="@+id/contenedorPaso2AsignarTurno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/indicadorPaso2AsignarTurno"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#E9ECEF"
                                app:cardCornerRadius="21dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/txtNumeroPaso2AsignarTurno"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="2"
                                    android:textColor="#7F8A9A"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/txtPaso2AsignarTurno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Fecha"
                                android:textColor="#7F8A9A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- CONECTOR 2 -->

                        <View
                            android:id="@+id/lineaPaso2AsignarTurno"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="18dp"
                            android:background="#D9E1F2" />


                        <!-- ================================================== -->
                        <!-- PASO 3 -->
                        <!-- ================================================== -->

                        <LinearLayout
                            android:id="@+id/contenedorPaso3AsignarTurno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/indicadorPaso3AsignarTurno"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#E9ECEF"
                                app:cardCornerRadius="21dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/txtNumeroPaso3AsignarTurno"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="3"
                                    android:textColor="#7F8A9A"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/txtPaso3AsignarTurno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Cuidador"
                                android:textColor="#7F8A9A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ESTADO DEL PASO -->

                    <TextView
                        android:id="@+id/txtEstadoPasoAsignarTurno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Paso 1 de 3 · Selecciona el turno"
                        android:textColor="#687078"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- TÍTULO -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloProgramarTurno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROGRAMAR TURNO"
                android:textColor="#687078"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ================================================== -->
            <!-- PASO 1 - SELECTOR DE TURNO -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloPasoTurno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="1. Seleccionar turno"
                android:textColor="#1D2939"
                android:textSize="14sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSelectorTurno"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Seleccionar turno"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#3B5BDB"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/selectorTipoTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:textColor="#1D2939"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================== -->
            <!-- INFORMACIÓN DEL TURNO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/cardInformacionTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/bg_search"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iconInformacionTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/clock"
                    android:contentDescription="Horario"
                    app:tint="#3B5BDB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreTurnoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#1D2939"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHorarioTurnoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================== -->
            <!-- PASO 2 - SELECCIONAR FECHA -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="2. Seleccionar fecha"
                android:textColor="#1D2939"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- ================================================== -->
            <!-- MESES -->
            <!-- ================================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMeses"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                tools:listitem="@layout/item_mes_calendario" />


            <!-- ================================================== -->
            <!-- DÍAS -->
            <!-- ================================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDias"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                tools:listitem="@layout/item_dia_calendario" />


            <!-- ================================================== -->
            <!-- INDICADOR -->
            <!-- ================================================== -->

            <View
                android:id="@+id/indicadorFechaSeleccionada"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_punto_azul" />


            <!-- ================================================== -->
            <!-- RESUMEN FECHA -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/cardResumenFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/redondeado_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha seleccionada"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inicio"
                            android:textColor="#98A2B3"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtFechaInicioSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="--"
                            android:textColor="#1D2939"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#E9ECEF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Final"
                            android:textColor="#98A2B3"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtFechaFinSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="--"
                            android:textColor="#1D2939"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDuracionSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Duración: --"
                    android:textColor="#3B5BDB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- PASO 3 - CUIDADORES -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/seccionCuidadoresAsignar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtTituloCuidadoresAsignar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="3. SELECCIONAR CUIDADORES"
                    android:textColor="#687078"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtAyudaCuidadoresAsignar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Selecciona uno o varios cuidadores disponibles para este turno."
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <!-- LISTA DE CUIDADORES DISPONIBLES -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCuidadoresAsignar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="5dp"
                    tools:listitem="@layout/item_cuidador_asignar_turno" />


                <!-- ================================================== -->
                <!-- CONFLICTOS ACTUALES -->
                <!-- ================================================== -->

                <TextView
                    android:id="@+id/txtConflictosTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:text=""
                    android:textColor="@color/secondary"
                    android:textSize="18sp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- RESUMEN FINAL DE ASIGNACIÓN -->
            <!-- ================================================== -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardResumenAsignacionTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ================================================== -->
                    <!-- TÍTULO -->
                    <!-- ================================================== -->

                    <TextView
                        android:id="@+id/txtTituloResumenAsignacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESUMEN DE ASIGNACIÓN"
                        android:textColor="#687078"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />


                    <!-- ================================================== -->
                    <!-- CANTIDAD DE CUIDADORES -->
                    <!-- ================================================== -->

                    <TextView
                        android:id="@+id/txtCantidadCuidadoresSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="0 cuidadores seleccionados"
                        android:textColor="#3B5BDB"
                        android:textSize="13sp"
                        android:textStyle="bold" />


                    <!-- ================================================== -->
                    <!-- DATOS DEL TURNO -->
                    <!-- ================================================== -->

                    <LinearLayout
                        android:id="@+id/cardDatosResumenTurno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_search">

                        <TextView
                            android:id="@+id/txtResumenTurno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Turno: --"
                            android:textColor="#1D2939"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtResumenFecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Fecha: --"
                            android:textColor="#687078"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- ================================================== -->
                    <!-- CUIDADORES SELECCIONADOS -->
                    <!-- ================================================== -->

                    <TextView
                        android:id="@+id/txtTituloCuidadoresSeleccionados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Cuidadores seleccionados"
                        android:textColor="#1D2939"
                        android:textSize="13sp"
                        android:textStyle="bold" />


                    <!--
                        Esta lista será dinámica.

                        Puede contener:
                        - 1 cuidador
                        - 2 cuidadores
                        - 5 cuidadores
                        - etc.

                        El Kotlin se encargará posteriormente
                        de actualizarla.
                    -->

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCuidadoresSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingBottom="2dp"
                        tools:listitem="@layout/item_cuidador_resumen_asignacion" />


                    <!-- ================================================== -->
                    <!-- CONTENEDOR DE CONFLICTOS -->
                    <!-- ================================================== -->

                    <LinearLayout
                        android:id="@+id/contenedorConflictosAsignacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:background="@drawable/bg_search">


                        <!-- TÍTULO DEL CONFLICTO -->

                        <TextView
                            android:id="@+id/txtTituloConflictosAsignacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚠ CONFLICTO DE TURNO"
                            android:textColor="#1D2939"
                            android:textSize="13sp"
                            android:textStyle="bold" />


                        <!-- MENSAJE -->

                        <TextView
                            android:id="@+id/txtMensajeConflictosAsignacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Uno o más cuidadores ya tienen un turno asignado para esta fecha."
                            android:textColor="#667085"
                            android:textSize="12sp" />


                        <!--Aqui aparecen unicamente los cuidadores que tienen conflicto con la fechgas -->

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerCuidadoresConConflicto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            tools:listitem="@layout/item_cuidador_conflicto_turno" />

                    </LinearLayout>


                    <!-- ================================================== -->
                    <!-- ESTADO DE VALIDACIÓN -->
                    <!-- ================================================== -->

                    <LinearLayout
                        android:id="@+id/contenedorEstadoAsignacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- INDICADOR -->

                        <TextView
                            android:id="@+id/iconEstadoAsignacion"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#18794E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- MENSAJE -->

                        <TextView
                            android:id="@+id/txtEstadoAsignacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Todos los cuidadores están disponibles."
                            android:textColor="#18794E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================== -->
            <!-- BOTÓN FINAL -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/btnAsignarTurnoGlobal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Asignar turno"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_azul"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ====================================================== -->
    <!-- MENÚ INFERIOR -->
    <!-- ====================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F7F9FC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- ================================================== -->
            <!-- INICIO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navInicioAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconInicioAsignarTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textInicioAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- ASIGNAR TURNO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navAsignarTurnoAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_nav_selected">

                <ImageView
                    android:id="@+id/iconAsignarTurnoAsignarTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendar_dia"
                    android:contentDescription="Asignar turno"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textAsignarTurnoAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- CITAS -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navCitasAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconCitasAsignarTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textCitasAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- MI PERFIL -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navPerfilAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconPerfilAsignarTurno"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/person_icon"
                    android:contentDescription="Mi perfil"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textPerfilAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>