<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- TÍTULO + NOTIFICACIONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GerIApp"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#DDE5FF"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- CAMPANA -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificacionesAsignarTurno"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificacionesAsignarTurno"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- CONTENIDO -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/headerAsignarTurno"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationAsignarTurno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">


            <!-- ================================================== -->
            <!-- TÍTULO -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROGRAMAR TURNO"
                android:textColor="#687078"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ================================================== -->
            <!-- SELECTOR DE TURNO -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Tipo de turno"
                android:textColor="#1D2939"
                android:textSize="14sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSelectorTurno"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Seleccionar turno"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#3B5BDB"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/selectorTipoTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:textColor="#1D2939"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================== -->
            <!-- INFORMACIÓN DEL TURNO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/cardInformacionTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/bg_search"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iconInformacionTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/clock"
                    android:contentDescription="Horario"
                    app:tint="#3B5BDB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreTurnoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diurno"
                        android:textColor="#1D2939"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHorarioTurnoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="07:00 - 19:00"
                        android:textColor="#98A2B3"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================== -->
            <!-- SELECCIONAR FECHA -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Seleccionar fecha"
                android:textColor="#1D2939"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- ================================================== -->
            <!-- MESES -->
            <!-- ================================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMeses"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                tools:listitem="@layout/item_mes_calendario" />


            <!-- ================================================== -->
            <!-- DÍAS -->
            <!-- ================================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDias"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                tools:listitem="@layout/item_dia_calendario" />


            <!-- ================================================== -->
            <!-- INDICADOR -->
            <!-- ================================================== -->

            <View
                android:id="@+id/indicadorFechaSeleccionada"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_punto_azul" />


            <!-- ================================================== -->
            <!-- RESUMEN FECHAS -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/cardResumenFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/redondeado_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rango seleccionado"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inicio"
                            android:textColor="#98A2B3"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtFechaInicioSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="--"
                            android:textColor="#1D2939"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#E9ECEF" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Final"
                            android:textColor="#98A2B3"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtFechaFinSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="--"
                            android:textColor="#1D2939"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <TextView
                    android:id="@+id/txtDuracionSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Duración: --"
                    android:textColor="#3B5BDB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- CUIDADORES -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/seccionCuidadoresAsignar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <TextView
                    android:id="@+id/txtTituloCuidadoresAsignar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="SELECCIONAR CUIDADORES"
                    android:textColor="#687078"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />


                <TextView
                    android:id="@+id/txtAyudaCuidadoresAsignar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Selecciona uno o varios cuidadores."
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCuidadoresAsignar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="5dp"
                    tools:listitem="@layout/item_cuidador_asignar_turno" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- BOTÓN -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/btnAsignarTurnoGlobal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Asignar turno"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_azul"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ====================================================== -->
    <!-- MENÚ INFERIOR -->
    <!-- ====================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationAsignarTurno"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="55dp"
        app:cardBackgroundColor="#E9ECEF"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">


            <!-- ================================================== -->
            <!-- 1. INICIO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navInicioAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconInicioAsignarTurno"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textInicioAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 2. ASIGNAR TURNO - SELECCIONADO -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navAsignarTurnoAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconAsignarTurnoAsignarTurno"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendar_dia"
                    android:contentDescription="Asignar turno"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textAsignarTurnoAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 3. CITAS -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navCitasAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconCitasAsignarTurno"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textCitasAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- 4. MI PERFIL -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/navPerfilAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconPerfilAsignarTurno"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/person"
                    android:contentDescription="Mi perfil"
                    app:tint="#98A2B3" />

                <TextView
                    android:id="@+id/textPerfilAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>