<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:rippleColor="#193B5BDB"
    app:strokeColor="#E9ECEF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">


        <!-- ========================= -->
        <!-- FOTO DEL CUIDADOR -->
        <!-- ========================= -->

        <ImageView
            android:id="@+id/imgCuidador"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Foto del cuidador"
            android:scaleType="centerCrop"
            android:src="@drawable/img" />


        <!-- ========================= -->
        <!-- INFORMACIÓN -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- NOMBRE -->

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cristiano Ronaldo Dos Santos Abeiro"
                android:textColor="#212529"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- CARGO -->

            <TextView
                android:id="@+id/txtCargo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Jefe De Jefes"
                android:textColor="#687078"
                android:textSize="13sp" />


            <!-- ESTADO + PACIENTES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- ESTADO -->

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_activo"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text="Activo"
                    android:textColor="@color/text_status"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <!-- SEPARADOR -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="#D9DEE7" />


                <!-- PACIENTES -->

                <TextView
                    android:id="@+id/txtPacientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 pacientes"
                    android:textColor="#687078"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- FLECHA -->
        <!-- ========================= -->

        <ImageView
            android:id="@+id/imgArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Ver información"
            android:src="@drawable/arrow" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>