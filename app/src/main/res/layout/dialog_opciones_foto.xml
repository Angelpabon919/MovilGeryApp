<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialogo_geriapp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foto de perfil"
        android:textColor="#243B80"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:text="Administra tu fotografía"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/opcionCambiarFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/bg_opcion_foto"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/persona_encargado"
            android:contentDescription="Cambiar foto"
            app:tint="#3B5BDB" />

        <TextView
            android:id="@+id/txtCambiarFoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Cambiar foto"
            android:textColor="#243B80"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/arrow"
            android:contentDescription="@null"
            app:tint="#94A3B8" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/opcionEliminarFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_opcion_foto"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Eliminar foto"
            app:tint="#DC2626" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Eliminar foto"
            android:textColor="#DC2626"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/arrow"
            android:contentDescription="@null"
            app:tint="#94A3B8" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCancelarFoto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Cancelar"
        android:textColor="#3B5BDB"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_opcion_foto"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
