<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="94dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

        <!-- ICONO DEL MEDICAMENTO -->
        <ImageView
            android:id="@+id/imgMedicamento"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_bienvenida_sede_circulo"
            android:padding="9dp"
            android:src="@drawable/ic_medicamento"
            android:contentDescription="Medicamento"
            app:tint="#3B5BDB"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- INFORMACION DEL MEDICAMENTO -->
        <LinearLayout
            android:id="@+id/layoutInfoMedicamento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/imgMedicamento"
            app:layout_constraintEnd_toStartOf="@id/layoutHoraMedicamento"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/tvNombreMedicamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#172033"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text=""/>

            <!-- DOSIS -->
            <TextView
                android:id="@+id/tvDosisMedicamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text=""/>

            <!-- PACIENTE -->
            <TextView
                android:id="@+id/tvPacienteMedicamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#3B5BDB"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Paciente: "/>

        </LinearLayout>

        <!-- HORA DEL MEDICAMENTO -->
        <LinearLayout
            android:id="@+id/layoutHoraMedicamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_bienvenida_sede_circulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock_blue"
                android:contentDescription="Hora"
                app:tint="#3B5BDB"/>

            <TextView
                android:id="@+id/tvHoraMedicamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#3B5BDB"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="08:00 AM"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
