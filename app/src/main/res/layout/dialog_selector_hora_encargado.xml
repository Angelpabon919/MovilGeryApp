<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selector_hora_dialog_encargado"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <!-- ENCABEZADO -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar hora"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elige la hora de la cita"
                android:textColor="#8A96A8"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="11dp"
            android:src="@drawable/ic_clock_blue"
            android:background="@drawable/bg_icono_calendario"
            android:contentDescription="Hora" />

    </RelativeLayout>

    <!-- DIVISOR -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E8ECF2" />

    <!-- HORA SELECCIONADA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHoraSeleccionada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:30"
            android:textColor="#3B5BDB"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hora seleccionada"
            android:textColor="#8A96A8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- SELECTORES -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- HORA -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora"
                android:textColor="#667085"
                android:textSize="12sp"
                android:textStyle="bold" />

            <NumberPicker
                android:id="@+id/pickerHora"
                android:layout_width="110dp"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

        <!-- DOS PUNTOS -->

        <TextView
            android:layout_width="24dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:text=":"
            android:textColor="#3B5BDB"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- MINUTOS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minutos"
                android:textColor="#667085"
                android:textSize="12sp"
                android:textStyle="bold" />

            <NumberPicker
                android:id="@+id/pickerMinutos"
                android:layout_width="110dp"
                android:layout_height="150dp"
                android:layout_marginTop="2dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTONES -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelarHora"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_cancelar_calendario_encargado"
            android:gravity="center"
            android:text="CANCELAR"
            android:textColor="#596579"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnSeleccionarHora"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_seleccionar_calendario_encargado"
            android:gravity="center"
            android:text="SELECCIONAR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>