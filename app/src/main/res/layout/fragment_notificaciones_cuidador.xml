<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootNotificaciones"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->
    <LinearLayout
        android:id="@+id/headerNotificaciones"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÓN VOLVER -->
        <ImageButton
            android:id="@+id/btnVolverNotificaciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:src="@drawable/arrow_back"
            app:tint="@color/white" />

        <!-- TÍTULO ENCABEZADO -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- CANTIDAD NO LEÍDAS -->
        <TextView
            android:id="@+id/txtCantidadNoLeidas"
            android:layout_width="28dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_badge_img"
            android:gravity="center"
            android:text="2"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ================================================= -->
    <!-- SUBTÍTULO ADAPTADO A CUIDADOR -->
    <!-- ================================================= -->
    <LinearLayout
        android:id="@+id/contenedorTituloNotificaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerNotificaciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alertas de turnos y pacientes"
            android:textColor="#1F2937"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mantente al tanto de los medicamentos y avisos recientes."
            android:textColor="#98A2B3"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ================================================= -->
    <!-- CONTENEDOR DE LISTA CON RECYCLERVIEW -->
    <!-- ================================================= -->
    <FrameLayout
        android:id="@+id/contenedorListaNotificaciones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorTituloNotificaciones"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- RecyclerView configurado para la lista -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_notificacion_encargado" />

        <ProgressBar
            android:id="@+id/progressBarNotificaciones"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>