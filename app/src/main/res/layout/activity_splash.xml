<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <FrameLayout
        android:id="@+id/contenedorAnimacion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/luzAzul"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:background="@drawable/splash_luz"
            android:alpha="0" />

        <ImageView
            android:id="@+id/imagenLinea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/splash_02_linea"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imagenCorazon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/splash_03_corazon_mano"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imagenPareja"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/splash_04_pareja"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imagenCompleta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/splash_05_pareja_completa"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imagenDestellos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/splash_06_pareja_destellos"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="invisible" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/indicadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/punto1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="5dp"
            android:background="#2563C7" />

        <View
            android:id="@+id/punto2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="5dp"
            android:background="#BBD7F7" />

        <View
            android:id="@+id/punto3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="5dp"
            android:background="#BBD7F7" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>