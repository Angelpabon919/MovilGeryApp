<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título + notificación -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GerIApp"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bienvenido, david"
                    android:textColor="#DDE5FF"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Campana -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="15dp"
                    android:src="@drawable/notifications"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones" />

                <TextView
                    android:id="@+id/txtNotificaciones"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge" />

            </FrameLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- BUSCADOR -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/bg_search">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/search"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/edtBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Buscar cuidadores..."
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- TÍTULO CUIDADORES -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- LISTA DE CUIDADORES -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- MENÚ INFERIOR -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/txtTituloCuidadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.08"
        android:text="CUIDADORES"
        android:textColor="#687078"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCuidadores"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="23dp"
        android:paddingEnd="17dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloCuidadores"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_cuidador_encargado" />

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="55dp"
        app:cardBackgroundColor="#E9ECEF"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- ================= -->
            <!-- INICIO -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconInicio"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/home"
                    android:contentDescription="Inicio"
                    app:tint="#3B5BDB"
                    />

                <TextView
                    android:id="@+id/textInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================= -->
            <!-- CITAS -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navCitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconCitas"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Citas" />

                <TextView
                    android:id="@+id/textCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================= -->
            <!-- BITÁCORA -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navBitacora"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconBitacora"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/bitacora"
                    android:contentDescription="Bitácora" />

                <TextView
                    android:id="@+id/textBitacora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bitácora"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- ================= -->
            <!-- MI PERFIL -->
            <!-- ================= -->

            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="7dp">

                <ImageView
                    android:id="@+id/iconPerfil"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/person"
                    android:contentDescription="Mi perfil" />

                <TextView
                    android:id="@+id/textPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#98A2B3"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>