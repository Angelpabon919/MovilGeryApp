<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="225dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="34dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ========================= -->
        <!-- TITULO + NOTIFICACIONES -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Logo GerIApp"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_geriapp1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GerIApp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hola"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Hola encargado David" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gestiona y acompaña el cuidado con bienestar"
                    android:textColor="#E5ECFF"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- NOTIFICACIONES -->
            <!-- ========================= -->

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_notifi"
                    android:contentDescription="Notificaciones"
                    android:padding="15dp"
                    android:src="@drawable/notifications" />

                <TextView
                    android:id="@+id/txtNotificaciones"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- BUSCADOR -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="Buscar"
                android:src="@drawable/search"
                app:tint="#667085" />

            <EditText
                android:id="@+id/edtBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar cuidadores..."
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#1F2937"
                android:textColorHint="#8A94A6"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- TITULO + FILTRO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/contenedorTituloCuidadores"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- TITULO -->

        <TextView
            android:id="@+id/txtTituloCuidadores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CUIDADORES"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- BOTON FILTRO -->

        <LinearLayout
            android:id="@+id/btnFiltroCuidadores"
            android:layout_width="116dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_filtro_cuidadores"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="9dp">

            <ImageView
                android:id="@+id/iconFiltroCuidadores"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Filtro de cuidadores"
                android:src="@drawable/ic_filtro"
                app:tint="#3B5BDB" />

            <TextView
                android:id="@+id/txtFiltroCuidadores"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Todos"
                android:textColor="#344054"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFlechaFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▾"
                android:textColor="#667085"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- INDICADOR DE CARGA -->
    <!-- ========================= -->

    <ProgressBar
        android:id="@+id/progressBarCuidadores"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorTituloCuidadores" />


    <!-- ========================= -->
    <!-- LISTA DE CUIDADORES -->
    <!-- ========================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCuidadores"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="105dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorTituloCuidadores"
        tools:listitem="@layout/item_cuidador_encargado" />


    <!-- ========================= -->
    <!-- MENU INFERIOR -->
    <!-- ========================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F7F9FC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- INICIO -->

            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:src="@drawable/home"
                    app:tint="#3B5BDB" />

                <TextView
                    android:id="@+id/textInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#3B5BDB"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ASIGNAR TURNO -->

            <LinearLayout
                android:id="@+id/navAsignarTurno"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconAsignarTurno"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Asignar turno"
                    android:src="@drawable/calendar_dia"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textAsignarTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Asignar turno"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- CITAS -->

            <LinearLayout
                android:id="@+id/navCitas"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconCitas"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Citas"
                    android:src="@drawable/calendario"
                    app:tint="#7F8A9A" />

                <TextView
                    android:id="@+id/textCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citas"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- MI PERFIL -->

            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Mi perfil"
                    android:src="@drawable/persona_encargado"
                    app:tint="#7F8A9A" />



                <TextView
                    android:id="@+id/textPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mi perfil"
                    android:textColor="#7F8A9A"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>