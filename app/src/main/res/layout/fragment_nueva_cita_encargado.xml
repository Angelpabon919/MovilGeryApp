<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/headerNuevaCita"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- VOLVER -->

        <ImageView
            android:id="@+id/btnVolverNuevaCita"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="Volver"
            app:tint="@color/white" />

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloNuevaCita"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:layout_marginStart="8dp"
            android:text="Nueva cita"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- NOTIFICACIONES -->

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/btnNotificacionesNuevaCita"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="15dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/notifications"
                android:background="@drawable/bg_notifi"
                android:contentDescription="Notificaciones" />

            <TextView
                android:id="@+id/txtNotificacionesNuevaCita"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge" />

        </FrameLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollNuevaCita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerNuevaCita"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ========================= -->
            <!-- PACIENTE -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PACIENTE"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPacienteCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgPacienteCita"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="9dp"
                        android:src="@drawable/img"
                        android:contentDescription="Paciente" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPacienteCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rosa Martínez"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHabitacionCita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Habitación 204 · Cama 2"
                            android:textColor="#667085"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================= -->
            <!-- TIPO DE CITA -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TIPO DE CITA"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/spinnerTipoCita"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown" />


            <!-- ========================= -->
            <!-- ESPECIALIDAD -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ESPECIALIDAD"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/spinnerEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown" />


            <!-- ========================= -->
            <!-- FECHA -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="FECHA"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/containerFechaCita"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtFechaCita"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seleccionar fecha"
                    android:textColor="#667085"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/imgFechaCita"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Seleccionar fecha" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- HORA -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="HORA"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/containerHoraCita"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtHoraCita"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seleccionar hora"
                    android:textColor="#667085"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/imgHoraCita"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendario"
                    android:contentDescription="Seleccionar hora" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- OBSERVACIONES -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="OBSERVACIONES"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/edtObservacionesCita"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Agregar observaciones..."
                android:padding="14dp"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="15sp"
                android:inputType="textMultiLine" />


            <!-- ========================= -->
            <!-- BOTÓN GUARDAR -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnGuardarCita"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="15dp"
                android:text="GUARDAR CITA"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#3B5BDB" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>