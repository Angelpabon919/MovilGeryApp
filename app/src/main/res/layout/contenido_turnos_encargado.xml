<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ========================================== -->
        <!-- TÍTULO -->
        <!-- ========================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TURNOS DEL CUIDADOR"
            android:textColor="#687078"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />


        <!-- ========================================== -->
        <!-- LUNES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/redondeado_card">

            <TextView
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:text="Lunes"
                android:textColor="#212529"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 - 14:00"
                    android:textColor="#212529"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turno mañana · 3 pacientes"
                    android:textColor="#687078"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Asignado"
                android:textColor="@color/text_status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />

        </LinearLayout>


        <!-- ========================================== -->
        <!-- MARTES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/redondeado_card">

            <TextView
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:text="Martes"
                android:textColor="#212529"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 - 14:00"
                    android:textColor="#212529"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turno mañana · 3 pacientes"
                    android:textColor="#687078"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Asignado"
                android:textColor="@color/text_status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />

        </LinearLayout>


        <!-- ========================================== -->
        <!-- MIÉRCOLES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/redondeado_card">

            <TextView
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:text="Miércoles"
                android:textColor="#212529"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:00 - 22:00"
                    android:textColor="#212529"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turno tarde · 3 pacientes"
                    android:textColor="#687078"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Asignado"
                android:textColor="@color/text_status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />

        </LinearLayout>


        <!-- ========================================== -->
        <!-- JUEVES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/redondeado_card">

            <TextView
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:text="Jueves"
                android:textColor="#212529"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 - 14:00"
                    android:textColor="#212529"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turno mañana · 3 pacientes"
                    android:textColor="#687078"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Asignado"
                android:textColor="@color/text_status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />

        </LinearLayout>


        <!-- ========================================== -->
        <!-- VIERNES -->
        <!-- ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/redondeado_card">

            <TextView
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:text="Viernes"
                android:textColor="#212529"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 - 14:00"
                    android:textColor="#212529"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Turno mañana · 3 pacientes"
                    android:textColor="#687078"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Asignado"
                android:textColor="@color/text_status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>