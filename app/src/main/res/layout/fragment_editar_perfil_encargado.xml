<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="155dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- BOTÓN VOLVER -->

            <ImageButton
                android:id="@+id/btnVolverEditarPerfil"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:padding="10dp"
                android:src="@drawable/arrow_back"
                android:background="@android:color/transparent"
                android:contentDescription="Volver"
                app:tint="@color/white" />

            <!-- TÍTULO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar información"
                    android:textColor="@android:color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Actualiza tus datos personales"
                    android:textColor="#DDE5FF"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENIDO DESPLAZABLE -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/headerEditarPerfil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- FOTO DE PERFIL -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgEditarPerfil"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="12dp"
                    android:src="@drawable/person"
                    android:background="@drawable/bg_estado_perfil"
                    android:contentDescription="Foto de perfil" />

                <TextView
                    android:id="@+id/btnCambiarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cambiar foto"
                    android:textColor="#3B5BDB"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DATOS PERSONALES -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="DATOS PERSONALES"
                android:textColor="#687078"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ================================================= -->
            <!-- NOMBRE COMPLETO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nombre completo"
                android:textColor="#344054"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreCompletoPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Ingresa tu nombre completo"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="14sp"
                android:inputType="textPersonName" />


            <!-- ================================================= -->
            <!-- DOCUMENTO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Documento"
                android:textColor="#344054"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDocumentoPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Número de documento"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="14sp"
                android:inputType="number" />


            <!-- ================================================= -->
            <!-- CORREO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Correo electrónico"
                android:textColor="#344054"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="correo@ejemplo.com"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="14sp"
                android:inputType="textEmailAddress" />


            <!-- ================================================= -->
            <!-- TELÉFONO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Teléfono"
                android:textColor="#344054"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTelefonoPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="300 000 0000"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="14sp"
                android:inputType="phone" />


            <!-- ================================================= -->
            <!-- BOTÓN GUARDAR -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/btnGuardarCambiosPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Guardar cambios"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_azul"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>