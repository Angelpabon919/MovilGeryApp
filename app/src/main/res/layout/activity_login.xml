<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".ui.auth.LoginActivity">

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingTop="175dp"
        android:paddingBottom="30dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA LOGIN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="79dp"
                android:layout_marginBottom="25dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:gravity="center"
                        android:text="Bienvenido de nuevo"
                        android:textColor="#102A56"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="25dp"
                        android:gravity="center"
                        android:text="Inicia sesión para continuar en GerIApp"
                        android:textColor="#64748B"
                        android:textSize="14sp"/>

                    <!-- CORREO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correo electrónico"
                        android:textColor="#102A56"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_input_login_moderno">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="15dp"
                            android:src="@drawable/mail"
                            android:contentDescription="@null"
                            app:tint="#173B78"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="49dp"
                            android:background="#D5E1F2"/>

                        <EditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="61dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:hint="correo@ejemplo.com"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:padding="0dp"
                            android:textColor="#172B4D"
                            android:textColorHint="#8793A8"
                            android:backgroundTint="@null"
                            android:autofillHints="emailAddress"
                            android:importantForAutofill="yes"
                            android:textIsSelectable="true"
                            android:textSize="15sp"/>
                    </FrameLayout>

                    <!-- CONTRASEÑA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Contraseña"
                        android:textColor="#102A56"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_input_login_moderno">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="15dp"
                            android:src="@drawable/ic_lock"
                            android:contentDescription="@null"
                            app:tint="#173B78"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="49dp"
                            android:background="#D5E1F2"/>

                        <EditText
                            android:id="@+id/etContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="61dp"
                            android:layout_marginEnd="48dp"
                            android:background="@android:color/transparent"
                            android:hint="Ingresa tu contraseña"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:singleLine="true"
                            android:padding="0dp"
                            android:textColor="#172B4D"
                            android:textColorHint="#8793A8"
                            android:textSize="15sp"/>

                        <ImageButton
                            android:id="@+id/btnMostrarContrasena"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end|center_vertical"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility_off"
                            android:tint="#64748B"
                            android:contentDescription="Mostrar u ocultar contraseña"
                            android:focusable="false"
                            android:clickable="true"/>
                    </FrameLayout>

                    <!-- OLVIDASTE CONTRASEÑA -->
                    <TextView
                        android:id="@+id/tvOlvidaste"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:gravity="end"
                        android:padding="4dp"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="#174FE5"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <!-- INICIAR SESIÓN -->
                    <Button
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Iniciar sesión"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"/>

                    <!-- SEPARADOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:layout_marginBottom="17dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#CBD5E1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:text="¿No tienes una cuenta?"
                            android:textColor="#64748B"
                            android:textSize="13sp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#CBD5E1"/>
                    </LinearLayout>

                    <!-- GOOGLE -->
                    <Button
                        android:id="@+id/btnGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_button_outline_login"
                        android:text="G   Continuar con Google"
                        android:textAllCaps="false"
                        android:textColor="#174FE5"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"/>

                    <!-- ID CONSERVADO PARA COMPATIBILIDAD -->
                    <TextView
                        android:id="@+id/tvCrearCuenta"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:text="Registrate"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <!-- HEADER FIJO -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg_header_login"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:translationY="-35dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:contentDescription="Logo GerIApp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_geriapp1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GerIApp"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Gestión geriátrica"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>