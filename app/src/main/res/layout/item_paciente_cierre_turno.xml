<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8EEF8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgAvatarPacienteCierre"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:contentDescription="Foto del paciente"
            android:scaleType="centerCrop"
            android:src="@drawable/person_icon"
            android:background="@drawable/bg_icono_cuidador"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePacienteCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del paciente"
                android:textColor="#203452"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHabitacionPacienteCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Habitación: --"
                android:textColor="#7E8BA2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDocumentoPacienteCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Documento: --"
                android:textColor="#7E8BA2"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Detalle"
            android:src="@drawable/ic_chevron_right"
            app:tint="#91A0B7" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>