<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPacienteResumen"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ENCABEZADO DEL PACIENTE -->
        <LinearLayout
            android:id="@+id/encabezadoPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombrePaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del paciente"
                    android:textColor="#1E293B"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvUbicacionPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Habitación 102 · Cama 2"
                    android:textColor="#64748B"
                    android:textSize="12sp"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/ivFlechaPaciente"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expandir información"
                app:tint="#2459C4"/>

        </LinearLayout>

        <!-- CONTENIDO COMPLETO DEL PACIENTE -->
        <LinearLayout
            android:id="@+id/contenedorContenidoPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp"
            android:visibility="visible">

            <!-- SEPARADOR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"/>

            <!-- BITÁCORAS DIARIAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bitácoras diarias"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvCantidadBitacoras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 registros"
                        android:textColor="#64748B"
                        android:textSize="12sp"/>

                </LinearLayout>

                <!-- AQUÍ SE CARGARÁN LAS BITÁCORAS -->
                <LinearLayout
                    android:id="@+id/contenedorBitacorasResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- SEPARADOR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#E2E8F0"/>

            <!-- CONTROLES PERIÓDICOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Controles periódicos"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvCantidadControles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 registros"
                        android:textColor="#64748B"
                        android:textSize="12sp"/>

                </LinearLayout>

                <!-- AQUÍ SE CARGARÁN LOS CONTROLES -->
                <LinearLayout
                    android:id="@+id/contenedorControlesPeriodicosResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>