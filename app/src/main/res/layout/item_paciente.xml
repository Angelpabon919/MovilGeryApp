<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPaciente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E9EDF4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- INFORMACIÓN DEL PACIENTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FOTO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardBackgroundColor="#F1F5FC"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5EAF3"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto del paciente"
                    android:scaleType="centerCrop"
                    android:src="@drawable/person_icon" />

            </com.google.android.material.card.MaterialCardView>

            <!-- INFORMACIÓN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombrePaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del paciente"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDetallesPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=""
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- ETIQUETAS -->
                <LinearLayout
                    android:id="@+id/layoutEtiquetasCuidado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEtiquetaCuidado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_cuidado"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#315BEB"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvEtiquetaRiesgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip_adulto"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#956000"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- SELECCIÓN -->
            <CheckBox
                android:id="@+id/cbSeleccionado"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:buttonTint="#315BEB"
                android:focusable="false"
                android:clickable="false"
                android:contentDescription="Seleccionar paciente" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>