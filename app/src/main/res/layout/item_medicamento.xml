<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#CBD5E1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Título y CheckBox de Administración -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Registro de Medicamento"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbEstadoAdministrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Administrado?"
                android:textColor="#6F9FEF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:buttonTint="#16A34A" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E2E8F0" />

        <!-- Fila 1: Fecha y Hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Fecha y Hora">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="datetime"
                    android:text="2026-09-09T09:00:00Z"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Vía de Admin.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etViaAdministracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:text="Oral"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Fila 2: Dosis Administrada -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Dosis Administrada">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDosisAdministrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="100 mg"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila 3: Observaciones / Nombre del Medicamento -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Observación / Medicamento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObservacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:text="Enalapril 10mg - En ayunas"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón para Guardar / Enviar a la API -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Guardar Registro"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>