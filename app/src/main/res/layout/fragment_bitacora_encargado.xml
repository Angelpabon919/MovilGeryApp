<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerBitacora"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================== -->
        <!-- TÍTULO + BOTÓN VOLVER -->
        <!-- ================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolverBitacora"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/arrow_back"
                android:tint="@android:color/white"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/txtTituloBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Bitácora del cuidador"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================== -->
        <!-- INFORMACIÓN DEL CUIDADOR -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/infoCuidadorBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FOTO -->
            <ImageView
                android:id="@+id/imgCuidadorBitacora"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img"
                android:contentDescription="Foto del cuidador" />


            <!-- DATOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreCuidadorBitacora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="María Fernández"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCargoCuidadorBitacora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Auxiliar de Enfermería"
                    android:textColor="#DDE5FF"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================== -->
        <!-- BUSCADOR -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/searchContainerBitacora"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_search">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/search"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/edtBuscarBitacora"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Buscar paciente o actividad..."
                android:singleLine="true"
                android:textColor="#212529"
                android:textColorHint="#8A8F98"
                android:textSize="14sp"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- CONTENIDO -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBitacora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/headerBitacora"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">


            <!-- ================================================== -->
            <!-- TÍTULO ACTIVIDAD -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ACTIVIDAD"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- ================================================== -->
            <!-- LISTA DE REGISTROS -->
            <!-- ================================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEventosBitacora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_evento_bitacora_encargado" />


            <!-- ================================================== -->
            <!-- MENSAJE SIN REGISTROS -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtSinRegistrosBitacora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:gravity="center"
                android:text="No hay registros en la bitácora"
                android:textColor="#98A2B3"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>