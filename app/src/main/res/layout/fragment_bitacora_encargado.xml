<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:id="@+id/headerBitacora"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÓN VOLVER -->

        <ImageButton
            android:id="@+id/btnVolverBitacora"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/arrow_back"
            app:tint="#FFFFFF" />

        <!-- NOMBRE DEL CUIDADOR -->

        <TextView
            android:id="@+id/txtNombreCuidadorBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="Nombre del cuidador" />

        <!-- CARGO DEL CUIDADOR -->

        <TextView
            android:id="@+id/txtCargoCuidadorBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="#E8EDFF"
            android:textSize="14sp"
            tools:text="Cuidador" />

    </LinearLayout>


    <!-- RESUMEN DE LA BITÁCORA -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResumenBitacora"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/headerBitacora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registros de bitácora"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtCantidadRegistrosBitacora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textColor="#1F2937"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icono_modulo"
                android:contentDescription="Bitácora"
                android:padding="11dp"
                android:src="@drawable/menu_book"
                app:tint="#3B5BDB" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- BUSCADOR CONSERVADO -->

    <LinearLayout
        android:id="@+id/searchContainerBitacora"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_search"
        app:layout_constraintTop_toBottomOf="@id/cardResumenBitacora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/search"
            android:contentDescription="Buscar" />

        <EditText
            android:id="@+id/edtBuscarBitacora"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="Buscar paciente o actividad..."
            android:singleLine="true"
            android:inputType="text"
            android:textColor="#212529"
            android:textColorHint="#8A8F98"
            android:textSize="14sp"
            android:padding="0dp" />

    </LinearLayout>


    <!-- TÍTULO DE LA LISTA -->

    <TextView
        android:id="@+id/txtTituloActividad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="20dp"
        android:text="Actividades"
        android:textColor="#1F2937"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/searchContainerBitacora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ESTADO DE CARGA -->

    <ProgressBar
        android:id="@+id/progressBarBitacora"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtTituloActividad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- LISTA DE REGISTROS -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEventosBitacora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="20dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/txtTituloActividad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_evento_bitacora_encargado" />


    <!-- SIN REGISTROS -->

    <TextView
        android:id="@+id/txtSinRegistrosBitacora"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="No hay registros en la bitácora."
        android:textColor="#98A2B3"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerEventosBitacora"
        app:layout_constraintBottom_toBottomOf="@id/recyclerEventosBitacora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>