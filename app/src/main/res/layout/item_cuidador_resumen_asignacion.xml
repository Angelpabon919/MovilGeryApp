<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCuidadorResumen"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- ================================================= -->
        <!-- AVATAR DEL CUIDADOR -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardAvatarCuidador"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="#E8F0FF"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/txtInicialCuidador"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="C"
                android:textColor="#3B5BDB"
                android:textSize="16sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>


        <!-- ================================================= -->
        <!-- INFORMACIÓN DEL CUIDADOR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- NOMBRE -->

            <TextView
                android:id="@+id/txtNombreCuidadorResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del cuidador"
                android:textColor="#1D2939"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- DOCUMENTO -->

            <TextView
                android:id="@+id/txtDocumentoCuidadorResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Documento: 0000000000"
                android:textColor="#667085"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ESTADO -->

            <TextView
                android:id="@+id/txtEstadoCuidadorResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Seleccionado"
                android:textColor="#3B5BDB"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- INDICADOR DE SELECCIÓN -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardIndicadorSeleccion"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#E8F0FF"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/txtIndicadorSeleccion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="#3B5BDB"
                android:textSize="15sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>