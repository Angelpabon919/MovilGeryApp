<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- ENCABEZADO AZUL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerEventos"
        android:layout_width="0dp"
        android:layout_height="225dp"
        android:background="@drawable/bg_rounded"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingTop="34dp"
        android:paddingBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FLECHA VOLVER -->
        <ImageView
            android:id="@+id/btnVolverEventos"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:padding="10dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="Volver"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- LOGO GERIAPP -->
        <ImageView
            android:id="@+id/logoGeriAppEventos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Logo GeriApp"
            android:scaleType="centerInside"
            android:src="@drawable/logo_geriapp1"
            app:layout_constraintStart_toEndOf="@id/btnVolverEventos"
            app:layout_constraintTop_toTopOf="@id/btnVolverEventos"
            app:layout_constraintBottom_toBottomOf="@id/btnVolverEventos" />

        <!-- CAMPANITA -->
        <ImageView
            android:id="@+id/btnNotificationCamara"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="-5dp"
            android:padding="8dp"
            android:background="@drawable/bg_notifi"
            android:src="@drawable/notifications"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Abrir notificaciones"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloEventos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="Eventos Cámara"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="start"
            app:layout_constraintStart_toEndOf="@id/logoGeriAppEventos"
            app:layout_constraintEnd_toStartOf="@id/btnNotificationCamara"
            app:layout_constraintTop_toTopOf="@id/logoGeriAppEventos"
            app:layout_constraintBottom_toBottomOf="@id/logoGeriAppEventos" />

        <!-- SUBTÍTULO -->
        <TextView
            android:id="@+id/tvSubtituloEventos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Eventos detectados por inteligencia artificial"
            android:textColor="#DCE7FF"
            android:textSize="14sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/btnVolverEventos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LISTADO DE EVENTOS IA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEventos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerEventos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MENSAJE SIN EVENTOS -->
    <TextView
        android:id="@+id/tvSinEventos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay eventos registrados"
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerEventos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerEventos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- INDICADOR DE CARGA -->
    <ProgressBar
        android:id="@+id/progressEventos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerEventos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerEventos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>