<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- ========================================== -->
    <!-- ENCABEZADO AZUL -->
    <!-- ========================================== -->

    <LinearLayout
        android:id="@+id/headerEventos"
        android:layout_width="0dp"
        android:layout_height="225dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="34dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FLECHA VOLVER -->
            <ImageView
                android:id="@+id/btnVolverEventos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:padding="10dp"
                android:src="@drawable/arrow_back"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/white" />

            <!-- LOGO GERIAPP -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Logo GeriApp"
                android:scaleType="centerInside"
                android:src="@drawable/logo_geriapp1" />

            <!-- TÍTULO -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Eventos Cámara"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Eventos detectados por inteligencia artificial"
            android:textColor="#DCE7FF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ========================================== -->
    <!-- LISTADO DE EVENTOS IA -->
    <!-- ========================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEventos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerEventos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================== -->
    <!-- MENSAJE SIN EVENTOS -->
    <!-- ========================================== -->

    <TextView
        android:id="@+id/tvSinEventos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay eventos registrados"
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerEventos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerEventos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================== -->
    <!-- INDICADOR DE CARGA -->
    <!-- ========================================== -->

    <ProgressBar
        android:id="@+id/progressEventos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerEventos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerEventos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
