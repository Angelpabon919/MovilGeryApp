<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- TIPO DE REGISTRO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- INDICADOR -->

            <View
                android:id="@+id/viewIndicadorEvento"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_activo" />


            <TextView
                android:id="@+id/txtTipoEvento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EVENTO ADVERSO"
                android:textColor="@color/text_status"
                android:textSize="11sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtHoraEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:35 AM"
                android:textColor="#98A2B3"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PACIENTE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNombrePacienteEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="María González"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- DESCRIPCIÓN -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtDescripcionEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Caída durante traslado"
            android:textColor="#687078"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- CUIDADOR -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtCuidadorEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cuidador: Carlos Rodríguez"
            android:textColor="#8A8F98"
            android:textSize="12sp" />


        <!-- ================================================= -->
        <!-- PARTE INFERIOR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtEstadoEvento"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="PENDIENTE"
                android:textColor="@color/text_status"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_activo" />


            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <TextView
                android:id="@+id/txtVerEvento"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:text="Ver detalle  ›"
                android:textColor="#3B5BDB"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>