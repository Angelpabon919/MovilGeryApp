<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:rippleColor="#193B5BDB"
    app:strokeColor="#E9ECEF"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- ICONO DEL REGISTRO -->

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icono_modulo">

                <ImageView
                    android:id="@+id/iconoEventoBitacora"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/menu_book"
                    android:contentDescription="Tipo de registro"
                    app:tint="#3B5BDB" />

            </FrameLayout>


            <!-- TIPO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTipoEventoBitacora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registro de actividad"
                    android:textColor="#212529"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Registro de bitácora"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- FLECHA -->

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/arrow"
                android:contentDescription="Ver detalle"
                app:tint="#98A2B3" />

        </LinearLayout>


        <!-- SEPARADOR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F0F2F5" />


        <!-- DESCRIPCIÓN -->

        <TextView
            android:id="@+id/txtDescripcionEventoBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Cuidado del paciente"
            android:textColor="#343A40"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- PACIENTE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/persona_encargado"
                android:contentDescription="Paciente"
                app:tint="#3B5BDB" />

            <TextView
                android:id="@+id/txtPacienteEventoBitacora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Paciente: Carlos Rodríguez"
                android:textColor="#687078"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- FECHA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/calendario"
                android:contentDescription="Fecha"
                app:tint="#3B5BDB" />

            <TextView
                android:id="@+id/txtFechaEventoBitacora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="10/09/2026 · 08:30 AM"
                android:textColor="#687078"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ESTADO -->

        <LinearLayout
            android:id="@+id/contenedorEstadoBitacora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconoEstadoBitacora"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/check_circle"
                android:contentDescription="Estado"
                app:tint="#3B5BDB" />

            <TextView
                android:id="@+id/txtEstadoEventoBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Actividad registrada"
                android:textColor="#3B5BDB"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>