<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E9ECEF"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- ================================================== -->
        <!-- ENCABEZADO DEL REGISTRO -->
        <!-- ================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- ICONO -->
            <ImageView
                android:id="@+id/iconoEventoBitacora"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/menu_book"
                android:background="@drawable/bg_icono_modulo"
                app:tint="#3B5BDB"
                android:contentDescription="Tipo de registro" />


            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTipoEventoBitacora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Registro de actividad"
                android:textColor="#212529"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================== -->
        <!-- DESCRIPCIÓN -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/txtDescripcionEventoBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginTop="12dp"
            android:text="Cuidado del paciente"
            android:textColor="#343A40"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================== -->
        <!-- PACIENTE -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/txtPacienteEventoBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginTop="5dp"
            android:text="Paciente: Carlos Rodríguez"
            android:textColor="#687078"
            android:textSize="13sp" />


        <!-- ================================================== -->
        <!-- FECHA Y HORA -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/txtFechaEventoBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginTop="12dp"
            android:text="10/09/2026 · 08:30 AM"
            android:textColor="#687078"
            android:textSize="12sp" />


        <!-- ================================================== -->
        <!-- ESTADO -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/contenedorEstadoBitacora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/iconoEstadoBitacora"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/check_circle"
                app:tint="#3B5BDB"
                android:contentDescription="Estado" />


            <TextView
                android:id="@+id/txtEstadoEventoBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Actividad registrada"
                android:textColor="#3B5BDB"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>