<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================================= -->
        <!-- HEADER DEL CUIDADOR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="22dp">

            <!-- ================================================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnVolver"
                    android:layout_width="35dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Volver"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Detalle del cuidador"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INFORMACIÓN DEL CUIDADOR -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgCuidador"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img"
                    android:background="@drawable/bg_rounded"
                    android:contentDescription="Foto del cuidador" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreCuidador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="María Fernández"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCargoCuidador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Auxiliar de Enfermería"
                        android:textColor="#DDE5FF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtIdCuidador"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="C-0042"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:background="#3152C8" />

                        <TextView
                            android:id="@+id/txtEstadoCuidador"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="Activo"
                            android:textColor="@color/text_status"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_activo" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RESUMEN -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/redondeado"
                android:padding="8dp">

                <!-- PACIENTES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PACIENTES"
                        android:textColor="#DDE5FF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCantidadPacientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- TURNOS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURNOS"
                        android:textColor="#DDE5FF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCantidadTurnos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ESTADO -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADO"
                        android:textColor="#DDE5FF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEstadoResumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Activo"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACCIONES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="35dp">

            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿QUÉ DESEAS GESTIONAR?"
                android:textColor="#687078"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Selecciona una opción para continuar."
                android:textColor="#8A8F98"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- ASIGNAR TURNO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/moduloTurnos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_modulo_cuidador"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:src="@drawable/calendario"
                    android:textSize="25sp"
                    android:background="@drawable/bg_icono_modulo"
                    app:tint="@color/colo_boton" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textTurnos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asignar turno"
                        android:textColor="#212529"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Programar sus días y horarios de trabajo"
                        android:textColor="#8A8F98"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#3B5BDB"
                    android:textSize="27sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PACIENTES ASIGNADOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/moduloPacientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_modulo_cuidador"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:src="@drawable/person"
                    android:textSize="24sp"
                    android:background="@drawable/bg_icono_modulo"
                    app:tint="@color/colo_boton" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textPacientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pacientes asignados"
                        android:textColor="#212529"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Ver los pacientes bajo su cuidado"
                        android:textColor="#8A8F98"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#3B5BDB"
                    android:textSize="27sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EVENTOS ADVERSOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/moduloEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_modulo_cuidador"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:src="@drawable/warning"
                    android:textSize="22sp"
                    android:background="@drawable/bg_icono_modulo"
                    app:tint="@color/colo_boton" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textEventos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eventos adversos"
                        android:textColor="#212529"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Revisar situaciones reportadas"
                        android:textColor="#8A8F98"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#3B5BDB"
                    android:textSize="27sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RESPONSABILIDADES -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/moduloResponsabilidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_modulo_cuidador"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#3B5BDB"
                    android:textSize="23sp"
                    android:background="@drawable/bg_icono_modulo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textResponsabilidades"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Responsabilidades"
                        android:textColor="#212529"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Consultar sus tareas asignadas"
                        android:textColor="#8A8F98"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#3B5BDB"
                    android:textSize="27sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>