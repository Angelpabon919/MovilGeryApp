<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E8EDF5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TIPO DE EVENTO Y RIESGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIconoEvento"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="●"
                android:textSize="22sp"
                android:textColor="#3B60D9"
                android:background="#EEF4FF"/>

            <TextView
                android:id="@+id/tvTipoEvento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Levantamiento detectado"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRiesgoEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="ALTO"
                android:textColor="#EA580C"
                android:textStyle="bold"
                android:textSize="11sp"
                android:backgroundTint="#FFF0E4"/>

        </LinearLayout>

        <!-- FECHA Y HORA -->
        <TextView
            android:id="@+id/tvFechaEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="08 oct 2026 · 20:10:55"
            android:textSize="12sp"
            android:textColor="#94A3B8"/>

        <!-- DATOS DEL PACIENTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F5F8FC"
            android:padding="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paciente"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvPacienteEvento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID 24"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habitación"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvHabitacionEvento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hab. 1"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cámara"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvCamaraEvento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cam. 1"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CONFIANZA, ESTADO Y DETALLES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConfianzaEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA: 95.00 %"
                android:textColor="#3B60D9"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvEstadoEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="detectado"
                android:textColor="#059669"
                android:textSize="11sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnDetalleEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Detalles ›"
                android:textColor="#3B60D9"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
