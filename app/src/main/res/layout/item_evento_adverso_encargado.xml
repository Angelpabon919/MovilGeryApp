<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E9ECEF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icono_modulo"
                android:contentDescription="Evento adverso"
                android:padding="9dp"
                android:src="@drawable/warning"
                app:tint="#3B5BDB" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloEvento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evento adverso"
                    android:textColor="#1F2937"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaEvento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="21/09/2026 14:30"
                    android:textColor="#98A2B3"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- PACIENTE -->

        <TextView
            android:id="@+id/txtPacienteEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Paciente: María López"
            android:textColor="#475467"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- DESCRIPCIÓN -->

        <TextView
            android:id="@+id/txtDescripcionEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Descripción del evento adverso."
            android:textColor="#667085"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- ACCIONES -->

        <TextView
            android:id="@+id/txtAccionesEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Acciones realizadas: ..."
            android:textColor="#667085"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- ESTADO -->

        <TextView
            android:id="@+id/txtEstadoEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_estado_evento"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Pendiente"
            android:textColor="#3B5BDB"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>