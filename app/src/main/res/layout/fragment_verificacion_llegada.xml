<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FF"
    tools:context=".ui.cuidador.llegada.VerificacionLlegadaFragment">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLlegada"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:background="@drawable/bg_header_llegada"
        android:paddingHorizontal="22dp"
        android:paddingTop="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/headerSuperior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Logo GerIApp"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_geriapp1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GerIApp"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

            </LinearLayout>
            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido Cuidador"
                android:textColor="#DCEBFF"
                android:textSize="15sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Verificación de Llegada"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/headerSuperior"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ubicación y registro de puntualidad para cuidador"
            android:textColor="#EAF2FF"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/scrollLlegada"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLlegada">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- MAPA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMapa"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="false">

                <FrameLayout
                    android:id="@+id/contenedorMapa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapa"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <!-- CONTROLES PERSONALIZADOS DEL MAPA -->
                    <LinearLayout
                        android:id="@+id/controlesZoom"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="14dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_controles_mapa"
                        android:elevation="6dp">

                        <TextView
                            android:id="@+id/btnZoomMas"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/azul_principal"
                            android:textSize="30sp"
                            android:textStyle="normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5EAF5"/>

                        <TextView
                            android:id="@+id/btnZoomMenos"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="@color/azul_principal"
                            android:textSize="30sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"/>

                    </LinearLayout>

                    <!-- BOTÓN PARA VOLVER A MI UBICACIÓN -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnMiUbicacion"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        app:useCompatPadding="false"
                        app:fabCustomSize="45dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        android:contentDescription="Volver a mi ubicación"
                        android:src="@drawable/ubicacion_cuidador"
                        app:backgroundTint="#3B5BDB"
                        app:tint="#FFFFFF"
                        app:fabSize="mini"
                        app:elevation="6dp"/>

                    <!-- ESTADO DE UBICACIÓN -->
                    <LinearLayout
                        android:id="@+id/cardEstadoUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_margin="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_p_ubicacion"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp">

                        <ProgressBar
                            android:id="@+id/progressUbicacion"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminateTint="#3B5BDB"/>

                        <TextView
                            android:id="@+id/tvEstadoUbicacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Buscando señal"
                            android:textColor="#2448C8"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEsperandoUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_p_ubicacion"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp"
                        android:text="Preparando mapa y ubicación"
                        android:textColor="#172B65"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- SEDE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/tvIconoSede"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_icono_llegada"
                        android:padding="10dp"
                        android:src="@drawable/ubicacion_cuidador"
                        android:contentDescription="Sede"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="13dp"
                        android:background="#B8C9F4"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sede asignada"
                            android:textColor="#71809D"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvNombreSede"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sede Residencial San Jerónimo"
                            android:textColor="#14265D"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDistancia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_p_ubicacion"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:text="0.0 km"
                        android:textColor="#315BE0"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- HORARIO Y ESTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- HORARIO -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHorario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="13dp">

                        <ImageView
                            android:id="@+id/tvIconoHorario"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icono_llegada"
                            android:padding="9dp"
                            android:src="@drawable/clock"
                            android:contentDescription="Horario"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHorarioTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Horario programado"
                                android:textColor="#71809D"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvHoraProgramada"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="7:00 AM"
                                android:textColor="#315BE0"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ESTADO -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEstadoLlegada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icono_llegada"
                            android:padding="9dp"
                            android:src="@drawable/check"
                            android:contentDescription="Estado"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Estado"
                                android:textColor="#71809D"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvEstadoLlegada"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Esperando llegada..."
                                android:textColor="#315BE0"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- TURNOS PENDIENTES -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTurnosPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:id="@+id/layoutTituloTurnos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/IconoTurno"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icono_llegada_12"
                            android:padding="9dp"
                            android:src="@drawable/clock"/>

                        <TextView
                            android:id="@+id/tvTituloTurnos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Turnos pendientes"
                            android:textColor="#14265D"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/btnExpandirTurnos"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_arrow_down"
                            android:contentDescription="Desplegar turnos"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerTurnos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSinTurnos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="12dp"
                            android:text="No tienes turnos pendientes"
                            android:textColor="#71809D"
                            android:textSize="13sp"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AVISO -->
            <LinearLayout
                android:id="@+id/tarjetaInformacionLlegada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_aviso_llegada"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textColor="#3B5BDB"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="2dp"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="13dp"
                    android:background="#3B5BDB"/>

                <TextView
                    android:id="@+id/tvInformacionLlegada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="La llegada se registra automáticamente al entrar en el radio permitido."
                    android:textColor="#172B65"
                    android:textSize="13sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnContinuarTemporal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
