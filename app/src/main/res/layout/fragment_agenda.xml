<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- ===================================================== -->
    <!-- ENCABEZADO AZUL -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerAgenda"
        android:layout_width="0dp"
        android:layout_height="145dp"
        android:background="@drawable/bg_rounded"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTituloAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Agenda"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvSubtituloAgenda"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvSubtituloAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pacientes con citas programadas"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAgenda"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- TÍTULO DE LA LISTA -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvListaAgenda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="Mis pacientes"
        android:textColor="@color/black"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/headerAgenda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- LISTA DE PACIENTES -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPacientesAgenda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="105dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvListaAgenda"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- MENSAJE CUANDO NO HAY CITAS -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvSinCitas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="No hay pacientes con citas programadas."
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvPacientesAgenda"
        app:layout_constraintBottom_toBottomOf="@id/rvPacientesAgenda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- CARGANDO -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressAgenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvPacientesAgenda"
        app:layout_constraintBottom_toBottomOf="@id/rvPacientesAgenda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/rvPacientesAgenda" />


    <!-- ===================================================== -->
    <!-- NAVEGACIÓN INFERIOR DEL CUIDADOR -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCuidador"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F7F9FC"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- ================================================= -->
            <!-- INICIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/iconInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:src="@drawable/home" />

                <TextView
                    android:id="@+id/textInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AGENDA -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navAgenda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/iconAgenda"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Agenda"
                    android:src="@drawable/agenda" />

                <TextView
                    android:id="@+id/textAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Agenda"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CÁMARAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navCamaras"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/iconCamaras"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Cámaras"
                    android:src="@drawable/outline_camera_video_24" />

                <TextView
                    android:id="@+id/textCamaras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cámaras"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/iconPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Perfil"
                    android:src="@drawable/persona_encargado" />

                <TextView
                    android:id="@+id/textPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Perfil"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>