<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adjuntar fotografía"
            android:textColor="#1E293B"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona cómo deseas agregar una imagen al evento."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"/>

        <!-- CÁMARA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/opcionCamara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F3"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_icono_cuidador"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="@color/black"
                    android:contentDescription="Cámara"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tomar una fotografía"
                        android:textColor="#1E293B"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Utilizar la cámara del dispositivo"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/arrow_forward"
                    android:tint="#94A3B8"
                    android:contentDescription="Seleccionar"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- GALERÍA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/opcionGaleria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F3"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_icono_cuidador"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:tint="@color/black"
                    android:contentDescription="Galería"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Elegir de la galería"
                        android:textColor="#1E293B"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar una imagen guardada"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/arrow_forward"
                    android:tint="#94A3B8"
                    android:contentDescription="Seleccionar"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarDialogo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#475569"
            app:backgroundTint="#F1F5F9"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>