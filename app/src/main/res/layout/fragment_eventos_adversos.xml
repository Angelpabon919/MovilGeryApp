<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- CONTENIDO DEL FORMULARIO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Qué sucedió?"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- DESCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="20dp"
                android:gravity="top"
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:hint="Describe lo que sucedió..."
                android:inputType="textMultiLine"
                android:padding="12dp" />

            <!-- EVALUACIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evaluación"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgEvaluacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbLeve"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leve" />

                <RadioButton
                    android:id="@+id/rbModerado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Moderado" />

                <RadioButton
                    android:id="@+id/rbGrave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grave" />

            </RadioGroup>

            <!-- SIGNOS VITALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signos vitales"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- TEMPERATURA Y FRECUENCIA CARDÍACA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTemperatura"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Temperatura °C"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="numberDecimal"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etFrecuencia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Frec. cardíaca"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- PRESIÓN ARTERIAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/etPresionSistolica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Presión sistólica"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etPresionDiastolica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Presión diastólica"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- FRECUENCIA RESPIRATORIA Y SATURACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/etFrecuenciaRespiratoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Frec. respiratoria"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etSaturacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Saturación %"
                    android:textColor="@color/black"
                    android:textColorHint="#94A3B8"
                    android:inputType="number"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- PESO -->
            <EditText
                android:id="@+id/etPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:hint="Peso (kg)"
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:inputType="numberDecimal" />

            <!-- OBSERVACIONES DE SIGNOS VITALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observaciones"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:hint="Observaciones de los signos vitales..."
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <!-- ACCIONES REALIZADAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acciones realizadas"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAccionesRealizadas"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:hint="Describe las acciones realizadas..."
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <!-- ESTADO DEL EVENTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado del evento"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Estado del evento"
                android:textColor="@color/black"
                android:textColorHint="#94A3B8"
                android:inputType="text"
                android:layout_marginBottom="24dp" />

            <!-- FOTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adjuntar foto"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAdjuntarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccionar foto"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Foto del evento adverso"
                android:layout_marginBottom="20dp" />

            <!-- GUARDAR -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar evento"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:layout_marginBottom="12dp" />

            <!-- CANCELAR -->
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="Cancelar" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>