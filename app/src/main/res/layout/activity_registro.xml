<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.auth.RegistroActivity">

    <ScrollView
        android:id="@+id/scrollRegistro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@color/color_primary">

                <TextView
                    android:id="@+id/tvVolver"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/white"
                    android:textSize="42sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTituloRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear cuenta"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CONTENIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="22dp"
                android:paddingEnd="25dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Completa tus datos"
                    android:textColor="@color/black"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:text="Registra tu información para crear tu cuenta"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <!-- FOTO DE PERFIL OPCIONAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Foto de perfil (opcional)"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- CONTENEDOR CIRCULAR DE LA FOTO -->
                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:background="@drawable/bg_foto_perfil_circular"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/imgFotoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_foto_perfil_interior"
                            android:clipToOutline="true"
                            android:contentDescription="Vista previa de la foto de perfil"
                            android:scaleType="centerCrop"
                            android:src="@drawable/person" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNombreFoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Puedes agregar una foto"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSeleccionarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Agregar fotografía"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/tvQuitarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="Quitar foto"
                        android:textColor="@color/color_primary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- NOMBRES -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Nombres"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombres"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ingresa tus nombres"
                    android:inputType="textPersonName"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />

                <!-- APELLIDOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Apellidos"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ingresa tus apellidos"
                    android:inputType="textPersonName"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />

                <!-- TIPO DE DOCUMENTO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tipo de documento"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spTipoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <!-- DOCUMENTO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Número de documento"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="Número de documento"
                    android:inputType="number"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />

                <!-- TELÉFONO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Teléfono"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="300 000 0000"
                    android:inputType="phone"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />

                <!-- CORREO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Correo electrónico"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="correo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Contraseña"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etContrasena"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Crea una contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/black"
                        android:textColorHint="#999999"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnMostrarContrasenaRegistro"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="Mostrar contraseña"
                        android:focusable="true"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_visibility_off"
                        app:tint="@color/color_text_secondary" />

                </LinearLayout>

                <!-- CONFIRMAR CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Confirmar contraseña"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etConfirmarContrasena"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Confirma tu contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/black"
                        android:textColorHint="#999999"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnMostrarConfirmarContrasenaRegistro"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="Mostrar confirmación de contraseña"
                        android:focusable="true"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_visibility_off"
                        app:tint="@color/color_text_secondary" />

                </LinearLayout>

                <!-- AVISO DE ROL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="15dp"
                    android:text="ⓘ  El rol de usuario será asignado por el administrador según tus funciones en la fundación."
                    android:textColor="@color/color_primary"
                    android:textSize="14sp" />

                <!-- REGISTRARSE -->
                <Button
                    android:id="@+id/btnRegistrarse"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Registrarse"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- INICIAR SESIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Ya tienes una cuenta? "
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvIniciarSesion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inicia sesión"
                        android:textColor="@color/color_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>