<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FC">

    <!-- ENCABEZADO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_rounded"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVolverResumen"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="9dp"
                android:src="@drawable/arrow_back"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvTituloResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cuidados de enfermería"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSubtituloResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen del turno"
                    android:textColor="#E5EDFF"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENIDO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/contenedorPacientesResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>

        </ScrollView>

        <LinearLayout
            android:id="@+id/contenedorCargandoResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressResumen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#2459C4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando resumen de cuidados..."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorEstadoResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/person_icon"
                android:contentDescription="Estado del resumen"
                android:alpha="0.6"/>

            <TextView
                android:id="@+id/tvEstadoResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay información disponible."
                android:textColor="#64748B"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>